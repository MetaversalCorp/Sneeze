# ---------------------------------------------------------------------------
# Generated build trees
# ---------------------------------------------------------------------------
# deps/repos/                shared source clones (one per dep)
# deps/builds/<plat>/<cfg>/  per-config dep scratch + install trees
# builds/<plat>/<cfg>/       Sneeze's own CMake scratch (build/) + install/{bin,lib}

deps/repos/
deps/builds/
builds/

# Rust/Cargo build output (any WASM guest crate — tools/, tests/, or the SDK)
**/wasm/**/target/

# Compiled WASM binaries (rebuilt from source)
*.wasm

# IDE and editor files
.vs/
.vscode/
*.user
*.suo
*.ncb
*.sdf
*.opensdf

# OS files
Thumbs.db
.DS_Store

# RepoResident session scratch (never commit)
.agent/scratch/*
!.agent/scratch/.gitkeep

# Memory / moat / secrets (local only — never commit)
.brain/
memory-bank/
.sessionmem-team/
graphify-out/
.env
.env.*
!.env.example
*.pem
*.key
secrets/
credentials.json
.cursor/mcp.json
*.bak
